# Default: browser speech recognition (Chrome/Edge) and speechSynthesis
ENABLE_STT=0
# Optional offline faster-whisper; first run of a named model might download weights
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# Optional LangGraph orchestration
USE_LANGGRAPH=0
# Optional local generative FAQ responses (only for unhandled general questions)
ENABLE_OLLAMA=0
OLLAMA_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
# Opt-in continuous audio streaming uses the same ENABLE_STT flag
# Install requirements-vad.txt for WebRTC VAD. Without it, use RMS fallback.
# Local bilingual 4B model; verify your computer has enough RAM/VRAM.
# Set ENABLE_OLLAMA=1 only after pulling the model with Ollama.

# Only enable on a public synthetic-data demo; protects browser WebSocket origins
# and caps each live connection at 30 message turns per minute.
PUBLIC_DEMO_MODE=0

# Hosted AI (Groq, OpenAI-compatible) is OPTIONAL. Never commit the real key.
ENABLE_HOSTED_LLM=0
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=  # Set as a secret in Render Environment, NOT in this file.
